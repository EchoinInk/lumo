    "decision:local-date-time-policy": {
      "id": "decision:local-date-time-policy",
      "invariants": [
        "Local days are YYYY-MM-DD civil keys and are never derived by slicing UTC instants",
        "Wall-clock times do not imply a date or timezone",
        "Timestamp instants include an offset and retain their absolute meaning",
        "Civil day arithmetic never uses fixed 24-hour durations",
        "Ambiguous legacy values are preserved without invented times"
      ],
      "sources": [
        "docs/local-date-time-policy.md"
      ],
      "status": "accepted",
      "title": "Use distinct civil dates, wall times and timestamp instants",
      "truth": "observed",
      "type": "decision",
