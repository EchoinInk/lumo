{
  "expo": {
    "name": "Mello",
    "slug": "lumo-mobile",
    "version": "1.0.0",
    "icon": "./assets/branding/mello/mello-app-icon-1024.png",
    "orientation": "portrait",
    "scheme": "lumomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.echoinink.lumo",
      "buildNumber": "1",
      "supportsTablet": false,
      "appleTeamId": "G9ZMQ5KQA6"
    },
    "android": {
      "package": "com.echoinink.lumo",
      "versionCode": 1,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/mello/mello-android-foreground.png",
        "backgroundColor": "#262334",
        "monochromeImage": "./assets/branding/mello/mello-android-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/mello/mello-notification-96.png",
          "color": "#3C6582",
          "defaultChannel": "lumo-reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/mello/mello-symbol-on-porcelain-256w.png",
          "imageWidth": 100,
          "backgroundColor": "#FAF7F8",
          "dark": {
            "image": "./assets/branding/mello/mello-symbol-on-plum-256w.png",
            "backgroundColor": "#262334"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/branding/mello/mello-favicon-48.png"
    }
  }
}
