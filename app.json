{
  "expo": {
    "name": "Lumo",
    "slug": "lumo-mobile",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "lumomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.echoinink.lumo",
      "buildNumber": "1",
      "supportsTablet": false,
      "appleTeamId": "G9ZMQ5KQA6"
    },
    "android": {
      "package": "com.echoinink.lumo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
