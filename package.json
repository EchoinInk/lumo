{
  "name": "lumo-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/run-tests.js",
    "test:watch": "node --watch scripts/run-tests.js",
    "test:typecheck": "npx tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "npx expo-doctor",
    "config:check": "node scripts/validate-native-config.js",
    "export:web": "node scripts/run-local-first.js expo export --platform web --output-dir dist/web --clear",
    "export:ios": "node scripts/run-local-first.js expo export --platform ios --output-dir dist/ios --clear",
    "export:android": "node scripts/run-local-first.js expo export --platform android --output-dir dist/android --clear",
    "export:native": "npm run export:ios && npm run export:android",
    "native:prebuild": "node scripts/run-local-first.js expo prebuild --clean",
    "native:ios:development": "node scripts/run-local-first.js expo run:ios",
    "native:android:development": "node scripts/run-local-first.js expo run:android",
    "native:ios:release": "node scripts/run-local-first.js expo run:ios --configuration Release --no-bundler",
    "native:android:release": "node scripts/run-local-first.js expo run:android --variant release --no-bundler",
    "validate:native": "npm run config:check && npm run export:native",
    "validate": "npm run config:check && npm run typecheck && npm run test && npm run lint && npm run doctor && npm run export:web && npm run export:native"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "expo": "^58.0.0-preview.8",
    "expo-blur": "~58.0.1",
    "expo-build-properties": "~58.0.8",
    "expo-constants": "~58.0.8",
    "expo-dev-client": "~58.0.8",
    "expo-font": "~58.0.3",
    "expo-haptics": "~58.0.2",
    "expo-image": "~58.0.7",
    "expo-linear-gradient": "~58.0.1",
    "expo-linking": "~58.0.8",
    "expo-notifications": "~58.0.9",
    "expo-router": "~58.0.9",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.3",
    "globals": "^16.5.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
